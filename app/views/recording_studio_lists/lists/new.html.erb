<% content_for :title, RecordingStudio.t("recording_studio.lists.new.title") %>
<% flat_pack_page_nav(
     round: true,
     style: :default,
     back_href: lists_path,
     back_tooltip: RecordingStudio.t("recording_studio.lists.new.back")
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::Grid::Component.new(cols: 2, align: :start) do %>
    <%= form_with url: lists_path, method: :post, class: "flex flex-col gap-(--stack-gap-md)" do %>
      <%= hidden_field_tag :idempotency_key, @idempotency_key %>
      <%= hidden_field_tag :recording_id, @recording_id if @recording_id.present? %>
      <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>

      <%= render FlatPack::TextInput::Component.new(
        name: "list[name]",
        label: RecordingStudio.t("recording_studio.lists.new.name"),
        value: @name,
        required: true,
        error: @name_error
      ) %>

      <%= render FlatPack::TextArea::Component.new(
        name: "list[description]",
        label: RecordingStudio.t("recording_studio.lists.new.description"),
        value: @description
      ) %>

      <%= render FlatPack::Button::Component.new(text: RecordingStudio.t("recording_studio.lists.new.create"), type: "submit", style: :primary) %>
    <% end %>
  <% end %>
</div>
