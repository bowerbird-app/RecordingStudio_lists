<% item_count = @items.size %>
<% count_label = RecordingStudio.t("recording_studio.lists.show.item_count", count: item_count) %>
<% description = @list.recordable.description.presence %>
<% subtitle = [description, count_label].compact.join(" · ") %>
<% content_for :title, @list.name %>
<% content_for :subtitle, subtitle %>
<% flat_pack_page_nav(
     round: true,
     style: :default,
     back_href: lists_path,
     back_tooltip: RecordingStudio.t("recording_studio.lists.show.back")
   ) %>
<% content_for :page_nav_right do %>
  <%= render FlatPack::TrashButton::Component.new(
        url: list_path(@list),
        method: :delete,
        expand: :left,
        size: :sm,
        confirm_label: RecordingStudio.t("recording_studio.lists.show.delete_confirm"),
        aria: { label: RecordingStudio.t("recording_studio.lists.show.delete") }
      ) %>
<% end %>

<div class="flex w-full flex-col gap-6">
  <% if @items.empty? %>
    <%= render FlatPack::EmptyState::Component.new(title: RecordingStudio.t("recording_studio.lists.show.empty")) %>
  <% else %>
    <%= render FlatPack::Grid::Component.new(cols: 2, align: :start) do %>
      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <%= render FlatPack::List::Component.new(divider: true, class: "!space-y-0") do %>
            <% @items.each do |item| %>
              <% trailing = nil %>
              <% if item %>
                <% trailing = capture do %>
                  <%= form_with url: item_list_path(@list, recording_id: item.id), method: :delete do %>
                    <%= render FlatPack::Button::Component.new(
                      text: RecordingStudio.t("recording_studio.lists.show.remove"),
                      icon: "trash",
                      icon_only: true,
                      type: "submit",
                      style: :ghost,
                      size: :sm
                    ) %>
                  <% end %>
                <% end %>
              <% end %>
              <%= render FlatPack::List::Item.new(trailing: trailing, class: "!items-center") do %>
                <%= item&.name.presence || RecordingStudio.t("recording_studio.lists.show.missing") %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
