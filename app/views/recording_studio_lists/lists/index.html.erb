<% recording_studio_page_nav(title: "Lists", page_nav_back_url: main_app.root_path, page_nav_back_label: "Home") %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Lists", variant: :h1) do |page_title| %>
    <% page_title.slot do %>
      <%= render FlatPack::Button::Component.new(text: "New list", href: new_list_path, style: :primary) %>
    <% end %>
  <% end %>

  <% if @lists.empty? %>
    <%= render FlatPack::EmptyState::Component.new(title: "No lists yet.") %>
  <% else %>
    <%= render FlatPack::Table::Component.new(data: @lists) do |table| %>
      <% table.column(title: "Name") do |list| %>
        <% render(FlatPack::Link::Component.new(href: list_path(list))) { list.name } %>
      <% end %>
      <% table.column(title: "Items") { |list| @item_counts.fetch(list.id.to_s, 0) } %>
    <% end %>
  <% end %>
</div>
