<% dummy_page_nav(
  title: "Lists",
  subtitle: "Name a list, then add the pages you want to keep together.",
  back_url: root_path
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::Button::Component.new(
    text: "Open lists",
    href: recording_studio_lists.lists_path,
    style: :primary
  ) %>

  <% if @featured_recording %>
    <div class="flex flex-col gap-(--stack-gap-md)">
      <p><%= @featured_recording.name %></p>
      <div class="flex items-center gap-(--stack-gap-md)">
        <%= recording_studio_add_to_list(@featured_recording) %>
        <%= recording_studio_add_to_list(
          @featured_recording,
          icon: "heart",
          icon_only: true,
          round: true
        ) %>
      </div>
    </div>
  <% end %>
</div>
